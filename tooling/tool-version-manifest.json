  "images": {
    "cpp_devcontainer": {
      "repository": "cpp-devcontainer",
      "default_tag": "dev"
    },
    "cpp26_dev_clang": {
      "repository": "cpp26-dev-clang",
      "default_tag": "dev"
    },
    "cpp26_dev_gcc": {
      "repository": "cpp26-dev-gcc",
      "default_tag": "dev"
    },
