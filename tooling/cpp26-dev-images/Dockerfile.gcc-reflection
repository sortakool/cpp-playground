ARG BASE_IMAGE=cpp-devcontainer-repo-base:dev
FROM ${BASE_IMAGE} AS builder

USER root
ARG DEBIAN_FRONTEND=noninteractive
ARG GCC_REFLECTION_REPO=https://forge.sourceware.org/marek/gcc.git
ARG GCC_REFLECTION_REF=95f5ec013f4ce8b3cd7f6f4434d3c36db11526a8

RUN apt-get update && apt-get install -y --no-install-recommends \
    flex bison texinfo gawk wget curl unzip xz-utils \
    libgmp-dev libmpfr-dev libmpc-dev libisl-dev zlib1g-dev \
    pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git init gcc-reflection && \
    cd gcc-reflection && \
    git remote add origin ${GCC_REFLECTION_REPO} && \
    if [ "${GCC_REFLECTION_REF}" = "reflection" ]; then \
      git fetch --depth 1 origin reflection; \
    else \
      git fetch --depth 1 origin ${GCC_REFLECTION_REF}; \
    fi && \
    git checkout FETCH_HEAD

WORKDIR /opt/gcc-reflection/build
RUN ../configure \
    --prefix=/opt/gcc-reflection-install \
    --enable-languages=c,c++ \
    --disable-bootstrap \
    --disable-multilib && \
    make -j"$(nproc)" && \
    make install

FROM ${BASE_IMAGE} AS validation

USER root
COPY --from=builder /opt/gcc-reflection-install /opt/gcc-reflection
ENV PATH="/opt/gcc-reflection/bin:${PATH}"
ENV CC=/opt/gcc-reflection/bin/gcc
ENV CXX=/opt/gcc-reflection/bin/g++

RUN printf '#include <meta>\nint main(){return 0;}\n' > /tmp/refl.cpp && \
    g++ -std=c++26 -freflection /tmp/refl.cpp -o /tmp/refl && \
    rm -f /tmp/refl.cpp /tmp/refl

FROM scratch AS artifact

COPY --from=builder /opt/gcc-reflection-install /opt/gcc-reflection
CMD ["/opt/gcc-reflection/bin/g++", "--version"]
