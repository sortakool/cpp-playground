ARG BASE_IMAGE=cpp-devcontainer-repo-base:dev
FROM ${BASE_IMAGE} AS builder

USER root
ARG DEBIAN_FRONTEND=noninteractive
ARG CLANG_P2996_REPO=https://github.com/bloomberg/clang-p2996.git
ARG CLANG_P2996_REF=a5270822dede40aaaf2c62381b89f110d2cfda4c

RUN apt-get update && apt-get install -y --no-install-recommends \
    libedit-dev libncurses5-dev libxml2-dev libzstd-dev libffi-dev swig && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git init clang-p2996 && \
    cd clang-p2996 && \
    git remote add origin ${CLANG_P2996_REPO} && \
    if [ "${CLANG_P2996_REF}" = "p2996" ]; then \
      git fetch --depth 1 origin p2996; \
    else \
      git fetch --depth 1 origin ${CLANG_P2996_REF}; \
    fi && \
    git checkout FETCH_HEAD

WORKDIR /opt/clang-p2996/build
RUN cmake -G Ninja ../llvm \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/clang-p2996-install \
    -DCMAKE_C_COMPILER=gcc \
    -DCMAKE_CXX_COMPILER=g++ \
    -DLLVM_ENABLE_PROJECTS="clang;lld" \
    -DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind" \
    -DLLVM_TARGETS_TO_BUILD="X86" \
    -DLLVM_CCACHE_BUILD=ON \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_ENABLE_BINDINGS=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF \
    -DCLANG_DEFAULT_CXX_STDLIB=libc++ && \
    ninja install

FROM ${BASE_IMAGE} AS validation

USER root
COPY --from=builder /opt/clang-p2996-install /opt/clang-p2996
RUN ln -sf /opt/clang-p2996/bin/clang /usr/local/bin/clang && \
    ln -sf /opt/clang-p2996/bin/clang++ /usr/local/bin/clang++

ENV VCPKG_ROOT=/opt/vcpkg
ENV PATH="/opt/clang-p2996/bin:${PATH}"
ENV CC=/usr/local/bin/clang
ENV CXX=/usr/local/bin/clang++

RUN printf '#include <meta>\nint main(){return 0;}\n' > /tmp/refl.cpp && \
    clang++ -std=c++2c -freflection -freflection-latest -fexpansion-statements \
      -stdlib=libc++ /tmp/refl.cpp -o /tmp/refl && \
    /tmp/refl && \
    rm -f /tmp/refl.cpp /tmp/refl

FROM scratch AS artifact

COPY --from=builder /opt/clang-p2996-install /opt/clang-p2996
CMD ["/opt/clang-p2996/bin/clang", "--version"]
