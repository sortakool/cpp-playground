# Copy this file to .devcontainer/devcontainer.env for local-only overrides.

# Host SSH port used for CLion/devcontainer SSH access.
# Default when unset: 3333
CPP_PLAYGROUND_DEVCONTAINER_SSH_PORT=3333

# Optional remote user override. Default when unset: the host username.
# CPP_PLAYGROUND_DEVCONTAINER_USER=rmanaloto
