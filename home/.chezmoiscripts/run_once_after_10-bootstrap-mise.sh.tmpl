#!/usr/bin/env bash
set -euo pipefail

repo="{{ .chezmoi.sourceDir }}"

if ! command -v mise >/dev/null 2>&1; then
  echo "cpp-playground: mise must be installed before chezmoi can bootstrap this repo" >&2
  exit 1
fi

if [ ! -f "$repo/mise.toml" ]; then
  echo "cpp-playground: expected mise.toml at $repo" >&2
  exit 1
fi

tmp_config="$(mktemp)"
trap 'rm -f "$tmp_config"' EXIT
: >"$tmp_config"

export MISE_GLOBAL_CONFIG_FILE="$tmp_config"
export MISE_IGNORED_CONFIG_PATHS="$HOME/.config/mise"

cd "$repo"
mise trust "$repo"
mise install --locked
mise reshim
