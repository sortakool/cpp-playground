{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "llvm-stable",
      "displayName": "LLVM stable lane",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/llvm/current/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/llvm/current/bin/clang++",
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "llvm-asan",
      "displayName": "LLVM + ASan/UBSan",
      "inherits": "llvm-stable",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "llvm-tsan",
      "displayName": "LLVM + TSan",
      "inherits": "llvm-stable",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=thread -fno-omit-frame-pointer"
      }
    },
    {
      "name": "llvm-msan",
      "displayName": "LLVM + MSan",
      "inherits": "llvm-stable",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=memory -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=memory -fno-omit-frame-pointer"
      }
    },
    {
      "name": "gcc-stable",
      "displayName": "GCC stable lane",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "x86_64-conda-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "x86_64-conda-linux-gnu-g++",
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "gcc-reflection",
      "displayName": "GCC reflection lane",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/local/bin/gcc-reflection",
        "CMAKE_CXX_COMPILER": "/usr/local/bin/g++-reflection",
        "CMAKE_CXX_STANDARD": "26"
      }
    },
    {
      "name": "clang-p2996",
      "displayName": "clang-p2996 lane",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/local/bin/clang-p2996",
        "CMAKE_CXX_COMPILER": "/usr/local/bin/clang-p2996++",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_CXX_FLAGS_INIT": "-freflection -freflection-latest -fexpansion-statements -stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-stdlib=libc++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "llvm-stable",
      "configurePreset": "llvm-stable"
    },
    {
      "name": "llvm-asan",
      "configurePreset": "llvm-asan"
    },
    {
      "name": "llvm-tsan",
      "configurePreset": "llvm-tsan"
    },
    {
      "name": "llvm-msan",
      "configurePreset": "llvm-msan"
    },
    {
      "name": "gcc-stable",
      "configurePreset": "gcc-stable"
    },
    {
      "name": "gcc-reflection",
      "configurePreset": "gcc-reflection"
    },
    {
      "name": "clang-p2996",
      "configurePreset": "clang-p2996"
    }
  ],
  "testPresets": [
    {
      "name": "llvm-stable",
      "configurePreset": "llvm-stable"
    },
    {
      "name": "llvm-asan",
      "configurePreset": "llvm-asan"
    },
    {
      "name": "llvm-tsan",
      "configurePreset": "llvm-tsan"
    },
    {
      "name": "llvm-msan",
      "configurePreset": "llvm-msan"
    },
    {
      "name": "gcc-stable",
      "configurePreset": "gcc-stable"
    },
    {
      "name": "gcc-reflection",
      "configurePreset": "gcc-reflection"
    },
    {
      "name": "clang-p2996",
      "configurePreset": "clang-p2996"
    }
  ]
}
